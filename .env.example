NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Model provider: ollama (default, local, $0) | openrouter | openai
PILOT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...

# Optional per-role overrides, e.g. PILOT_WORKER_MODEL=ollama/qwen3:8b
# Hard spend cap for hosted models (stops at 90%)
# PILOT_BUDGET_USD=2
# Fault injection for the recovery demo, e.g. PILOT_CHAOS=draft
# PILOT_CHAOS=
