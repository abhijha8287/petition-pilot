{
  "name": "exhibit-a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,supavisor",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/types.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "aao:ingest": "tsx --env-file=.env.local scripts/ingest-aao.ts",
    "pipeline": "tsx --env-file=.env.local scripts/pipeline.ts",
    "mcp": "tsx --env-file=.env.local scripts/mcp-server.ts",
    "eval:golden": "tsx --env-file=.env.local evals/objection-recall.ts",
    "eval:faithfulness": "tsx --env-file=.env.local evals/faithfulness.ts",
    "eval:reliability": "tsx --env-file=.env.local evals/reliability.ts",
    "eval:report": "tsx --env-file=.env.local evals/report.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@ai-sdk/openai-compatible": "^3.0.84",
    "@ai-sdk/react": "^4.0.166",
    "@mastra/core": "^1.81.0",
    "@mastra/evals": "^1.10.10",
    "@mastra/loggers": "^1.3.10",
    "@mastra/mcp": "^2.7.0",
    "@mastra/pg": "^1.34.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.162",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "undici": "^8.12.3",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "pdf-lib": "^1.17.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
